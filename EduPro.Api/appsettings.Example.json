{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "dbcontext": "Data Source=YOUR_SERVER;Initial Catalog=EduProDB;Integrated Security=True;Trust Server Certificate=True"
  },
  "AiService": {
    "BaseUrl": "http://localhost:8001"
  },
  "jwtSettings": {
    "secret": "YOUR_LONG_RANDOM_SECRET",
    "issuer": "EduPro",
    "audience": "EduProUsers",
    "validateAudience": true,
    "validateIssuer": true,
    "validateLifetime": true,
    "validateIssuerSigningKey": true,
    "AccessTokenExpireDate": 1,
    "RefreshTokenExpireDate": 20
  },
  "emailSettings": {
    "port": "465",
    "host": "smtp.gmail.com",
    "FromEmail": "your-email@example.com",
    "password": "YOUR_APP_PASSWORD"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.MSSqlServer"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "System": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "ConnectionString": "Data Source=YOUR_SERVER;Initial Catalog=EduProDB;Integrated Security=True;Trust Server Certificate=True",
          "tableName": "SystemLogs",
          "autoCreateSqlTable": true
        }
      }
    ]
  },
  "GoogleAuthSettings": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID"
  }
}